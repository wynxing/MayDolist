{
  "name": "maydolist",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "demo": "tauri dev -- -- --demo",
    "tauri": "tauri",
    "check": "vue-tsc --noEmit",
    "gen:types": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"!src/types/generated/**\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"!src/types/generated/**\"",
    "test": "vitest run",
    "release": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "pinia": "^3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  }
}

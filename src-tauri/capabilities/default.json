{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, floating notes, quick capture and command palette",
  "windows": ["main", "note-*", "quick-capture", "command-palette"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "process:default",
    "updater:default"
  ]
}

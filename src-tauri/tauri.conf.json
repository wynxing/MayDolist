{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MayDolist",
  "version": "1.3.1",
  "identifier": "com.wynn.maydolist",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMTQ4NjE4MDQ3ODI5RkUKUldUK0tYZ0VHSVlVaTRCVzhJMDBjSllSVHRVbDdYaEdGbmZXRXhOSFZkSTJ3amdHbFpuNjMraU4K",
      "endpoints": [
        "https://github.com/wynxing/MayDolist/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MayDolist",
        "width": 860,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "radius": 12
        }
      },
      {
        "label": "quick-capture",
        "title": "MayDolist 快速收集",
        "url": "index.html?quick",
        "width": 560,
        "height": 132,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "radius": 12
        }
      },
      {
        "label": "command-palette",
        "title": "MayDolist 命令面板",
        "url": "index.html?palette",
        "width": 640,
        "height": 440,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src ipc: http://ipc.localhost ws://localhost:1421 http://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
